{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "firefox",
      "request": "launch",
      "name": "Launch firefox against localhost",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}",
      "pathMappings": [
        {
          "url": "http://localhost:5173/app",
          "path": "${workspaceFolder}/apps/frontend/app"
        },
        {
          "url": "http://localhost:5173/@fs",
          "path": ""
        }
      ]
    }
  ]
}
