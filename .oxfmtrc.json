{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "trailingComma": "es5",
  "tabWidth": 2,
  "semi": false,
  "singleQuote": true,
  "printWidth": 100,
  "sortPackageJson": {
    "sortScripts": true
  },
  "sortImports": {
    "partitionByNewline": true,
    "newlinesBetween": false
  },
  "ignorePatterns": []
}
