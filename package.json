{
  "name": "assessmentis",
  "version": "0.0.1",
  "description": "A tool for diagnostic interviews",
  "main": "index.js",
  "packageManager": "npm@10.9.2",
  "prettier": "@assessmentis/prettier-config",
  "scripts": {
    "build": "npm exec turbo run build",
    "dev": "npm exec turbo run dev",
    "lint": "npm run lint:projects && npm run lint:docs",
    "lint:projects": "turbo run lint",
    "lint:docs": "markdownlint-cli2 -- --config .local.markdownlint-cli2.mjs",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "vitest --project=\"*:unit\"",
    "test:all": "vitest",
    "format": "npm exec prettier --write \"**/*.{ts,tsx,md}\"",
    "docs": "typedoc"
  },
  "author": "Ruth Marks",
  "license": "UNLICENSED",
  "workspaces": [
    "global/eslint-config",
    "global/typescript-config",
    "global/prettier-config",
    "global/react-util",
    "global/util",
    "global/ontology",
    "global/daily-co-components",
    "global/testing-utils",
    "domain/platform-domain",
    "domain/clinical-domain",
    "domain/config-domain",
    "domain/fhir-client",
    "domain/questionnaire-entities",
    "domain/document-template-kinds",
    "domain/video-call-domain",
    "infrastructure/firebase-web-infrastructure",
    "infrastructure/firebase-server-infrastructure",
    "infrastructure/google-fhir-web-infrastructure",
    "infrastructure/google-fhir-node-infrastructure",
    "infrastructure/daily-co-infrastructure",
    "infrastructure/google-meet-infrastructure",
    "infrastructure/document-template-instances",
    "apps/functions",
    "apps/frontend",
    "apps/firecms",
    "apps/aws_infra"
  ],
  "dependencies": {
    "@assessmentis/document-template-kinds": "^0.0.1",
    "prettier": "^3.7.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "npm:noist@^1.0.0",
    "vite": "^7.3.1"
  },
  "devDependencies": {
    "@effect/language-service": "^0.72.0",
    "eslint": "^9.39.1",
    "markdownlint": "^0.40.0",
    "markdownlint-cli2": "^0.20.0",
    "markdownlint-cli2-formatter-pretty": "^0.0.9",
    "markdownlint-rule-relative-links": "^5.0.1",
    "turbo": "^2.6.1",
    "typedoc": "^0.28.17"
  }
}
