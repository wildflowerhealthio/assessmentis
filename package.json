{
  "name": "assessmentis",
  "version": "0.0.1",
  "description": "A tool for diagnostic interviews",
  "license": "UNLICENSED",
  "author": "Ruth Marks",
  "workspaces": [
    "global/typescript-config",
    "global/react-util",
    "global/util",
    "global/ontology",
    "global/daily-co-components",
    "global/testing-utils",
    "global/effectful-store",
    "domain/platform-domain",
    "domain/clinical-domain",
    "domain/config-domain",
    "domain/fhir-r4",
    "domain/questionnaire-entities",
    "domain/document-template-kinds",
    "domain/video-call-domain",
    "infrastructure/firebase-web-infrastructure",
    "infrastructure/firebase-server-infrastructure",
    "infrastructure/google-account-infrastructure",
    "infrastructure/google-fhir-web-infrastructure",
    "infrastructure/google-fhir-node-infrastructure",
    "infrastructure/daily-co-infrastructure",
    "infrastructure/document-template-instances",
    "apps/functions",
    "apps/frontend",
    "apps/firecms",
    "apps/aws_infra"
  ],
  "main": "index.js",
  "scripts": {
    "build": "npm exec turbo run build",
    "dev": "npm exec turbo run dev",
    "lint": "npm run lint:projects && npm run lint:docs",
    "lint:projects": "oxlint ./apps ./domain ./global ./infrastructure",
    "lint:docs": "npm exec markdownlint-cli2 -- --config .local.markdownlint-cli2.mjs",
    "lint:fix": "oxlint --fix  ./apps ./domain ./global ./infrastructure",
    "typecheck": "npm exec turbo run typecheck",
    "test": "vitest --project=\"*:unit\"",
    "test:all": "vitest",
    "format": "npm exec oxfmt --write ./apps ./domain ./global ./infrastructure",
    "docs": "typedoc"
  },
  "dependencies": {
    "@assessmentis/document-template-kinds": "^0.0.1",
    "@typescript/native-preview": "^7.0.0-dev.20260318.1",
    "oxlint-tsgolint": "^0.17.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "npm:noist@^1.0.0",
    "vite": "^7.3.1"
  },
  "devDependencies": {
    "@effect/language-service": "^0.72.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "markdownlint": "^0.40.0",
    "markdownlint-cli2": "^0.20.0",
    "markdownlint-cli2-formatter-pretty": "^0.0.9",
    "markdownlint-rule-relative-links": "^5.0.1",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "turbo": "^2.6.1",
    "typedoc": "^0.28.17"
  },
  "packageManager": "npm@10.9.2"
}
