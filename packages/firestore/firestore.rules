rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
    	let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
    	return userDoc == null ? null : userDoc.data;
    }
    
    function isGlobalAdmin() {
      return false;
    }
    
    function getOrgRoles(orgId) {
    	let userData = getUserData();
      return (
      	isSignedIn()
      	&& userData != null 
        	? userData.org_roles[orgId]
          : []
      )
    }
    
    function canReadOrgInternal(orgId) {
    	let orgRoles = getOrgRoles(orgId);
      return isGlobalAdmin() || orgRoles.hasAny(['admin', 'clinician'])
      
    }
    
    function canManageConfig(orgId) {
    	let orgRoles = getOrgRoles(orgId);
      return isGlobalAdmin() || orgRoles.hasAny(['admin'])
    }


    match /users/{uid} {
      allow get, list: if isSignedIn() && request.auth.uid == uid || isGlobalAdmin();
      allow create, update, delete: if isSignedIn() && isGlobalAdmin();
    }

    match /public_org_configs/{orgId} {
      allow get: if canReadOrgInternal(orgId);
      allow create, update, delete: if canManageConfig(orgId);
    }
    
    match /private_org_configs/{orgId} {
      allow get: if canReadOrgInternal(orgId);
      allow create, update, delete: if canManageConfig(orgId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
