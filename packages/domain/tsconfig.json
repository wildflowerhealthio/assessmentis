{
  "include": ["src/**/*"],
  "compilerOptions": {
    "module": "ES2022",
    "target": "ES2022",
    "moduleResolution":"bundler",
    "declaration": true,
    "outDir": "dist/",
    "baseUrl": ".",
    "skipLibCheck": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
}
