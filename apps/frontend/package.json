{
  "name": "@assessmentis/frontend",
  "version": "0.0.1",
  "private": true,
  "description": "The frontend for Assessment.is",
  "license": "UNLICENSED",
  "author": "Ruth Marks",
  "type": "module",
  "scripts": {
    "build": "react-router typegen && react-router build",
    "build-storybook": "storybook build",
    "codegen": "react-router typegen",
    "deploy": "firebase deploy --only hosting",
    "dev": "react-router dev",
    "lint": "oxlint --config ./.oxlintrc.json ./app/",
    "lint:fix": "oxlint --config ./.oxlintrc.json --fix ./app/",
    "start": "react-router-serve ./build/server/index.js",
    "storybook": "storybook dev -p 6006",
    "test": "vitest --project frontend:unit",
    "test:e2e": "playwright test",
    "test:e2e:codegen": "playwright codegen http://localhost:5173",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "npm exec codegen && tsc --noEmit"
  },
  "dependencies": {
    "@assessmentis/clinical-domain": "*",
    "@assessmentis/daily-co-components": "*",
    "@assessmentis/daily-co-infrastructure": "*",
    "@assessmentis/google-account-infrastructure": "*",
    "@assessmentis/google-fhir-web-infrastructure": "*",
    "@assessmentis/ontology": "*",
    "@assessmentis/react-util": "*",
    "@assessmentis/video-call-domain": "*",
    "@effect/opentelemetry": "^0.61.0",
    "@effect/platform": "^0.94.0",
    "@effect/platform-browser": "^0.74.0",
    "@esbuild-plugins/node-globals-polyfill": "^0.2.3",
    "@esbuild-plugins/node-modules-polyfill": "^0.2.2",
    "@headlessui/react": "^2.2.9",
    "@opentelemetry/exporter-trace-otlp-http": "^0.208.0",
    "@opentelemetry/resources": "^2.2.0",
    "@opentelemetry/sdk-metrics": "^2.2.0",
    "@opentelemetry/sdk-trace-base": "^2.2.0",
    "@opentelemetry/sdk-trace-node": "^2.2.0",
    "@opentelemetry/sdk-trace-web": "^2.2.0",
    "@opentelemetry/semantic-conventions": "^1.38.0",
    "@react-router/fs-routes": "^7.9.6",
    "@react-router/node": "^7.9.6",
    "@react-router/serve": "^7.9.6",
    "@storybook/react-vite": "^10.1.1",
    "@tanstack/react-query": "^5.90.16",
    "@types/google.accounts": "^0.0.18",
    "@types/jsdom": "^27.0.0",
    "effect": "^3.19.8",
    "effect-query": "^0.2.1",
    "firebase": "^12.6.0",
    "isbot": "^5.1.32",
    "jsonwebtoken": "^9.0.2",
    "modern-normalize": "^3.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-error-boundary": "^6.0.0",
    "react-loading-skeleton": "^3.5.0",
    "react-router": "^7.9.6",
    "temporal-polyfill": "^0.3.0",
    "tundra-css": "^0.13.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@assessmentis/testing-utils": "*",
    "@assessmentis/typescript-config": "*",
    "@chromatic-com/storybook": "^4.1.3",
    "@fast-check/vitest": "^0.2.4",
    "@playwright/test": "^1.57.0",
    "@react-router/dev": "^7.9.6",
    "@storybook/addon-a11y": "^10.1.11",
    "@storybook/addon-docs": "^10.1.11",
    "@storybook/addon-onboarding": "^10.1.11",
    "@storybook/addon-vitest": "^10.1.11",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/fhir": "^0.0.41",
    "@types/gapi": "^0.0.47",
    "@types/gapi.client.healthcare-v1": "^0.0.4",
    "@types/node": "^24",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser-playwright": "^4.0.16",
    "@vitest/coverage-v8": "^4.0.16",
    "jsdom": "^27.4.0",
    "playwright": "^1.57.0",
    "rollup-plugin-node-polyfills": "^0.2.1",
    "storybook": "^10.1.11",
    "typescript": "^5.9.2",
    "vite": "*",
    "vite-plugin-node-polyfills": "^0.24.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.16"
  }
}
