{
  "extends": "@assessmentis/typescript-config/base.json",
  "include": ["src"],
  "exclude": ["node_modules", "eslint.config.cjs"],
  "compilerOptions": {
    "module": "NodeNext",
    "esModuleInterop": true,
    "moduleResolution": "nodenext",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "dist",
    "sourceMap": true,
    "strict": true,
    "target": "es2017"
  }
}
