{
  "name": "@assessmentis/functions",
  "version": "0.0.1",
  "description": "Cloud functions for Assessmentis",
  "author": "Ruth Marks",
  "license": "UNLICENSED",
  "prettier": "@assessmentis/prettier-config",
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "lint": "eslint \"./src/**/*\"",
    "lint:fix": "eslint --fix \"./src/**/*\"",
    "test": "echo \"No tests in this package\"",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.js",
  "dependencies": {
    "@effect/opentelemetry": "^0.59.1",
    "eslint": "^9.39.1",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.1",
    "googleapis": "^168.0.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@assessmentis/prettier-config": "file:../../global/prettier-config",
    "@types/gapi": "^0.0.47",
    "@types/gapi.client.healthcare-v1": "^0.0.4",
    "@types/node-fetch": "^3.0.2",
    "firebase-functions-test": "^3.4.1",
    "typescript": "^5.9.2"
  },
  "private": true
}
