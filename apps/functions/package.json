{
  "name": "@assessmentis/functions",
  "version": "0.0.1",
  "private": true,
  "description": "Cloud functions for Assessmentis",
  "license": "UNLICENSED",
  "author": "Ruth Marks",
  "main": "dist/index.js",
  "scripts": {
    "build": "node build.mjs",
    "deploy": "firebase deploy --only functions",
    "lint": "oxlint ./{src,test}/",
    "lint:fix": "oxlint --fix ./{src,test}/",
    "logs": "firebase functions:log",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@assessmentis/config-domain": "*",
    "@effect/cluster": "^0.56.3",
    "@effect/opentelemetry": "^0.61.0",
    "@effect/platform": "^0.94.0",
    "@effect/platform-node": "^0.104.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.211.0",
    "effect": "^3.19.9",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.5",
    "googleapis": "^168.0.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/gapi": "^0.0.47",
    "@types/gapi.client.healthcare-v1": "^0.0.4",
    "@types/node": "^25.2.3",
    "@types/node-fetch": "^3.0.2",
    "esbuild": "^0.27.3",
    "fast-check": "^3.23.2",
    "firebase-functions-test": "^3.4.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "engines": {
    "node": "24"
  }
}
