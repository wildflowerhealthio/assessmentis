{
  "name": "@assessmentis/functions",
  "version": "0.0.1",
  "description": "Cloud functions for Assessmentis",
  "author": "Ruth Marks",
  "license": "UNLICENSED",
  "prettier": "@assessmentis/prettier-config",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --outfile=lib/index.js --format=esm --external:./node_modules/*",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"./src/**/*\"",
    "lint:fix": "eslint --fix \"./src/**/*\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "type": "module",
  "main": "dist/apps/functions/src/index.js",
  "types": "dist/apps/functions/src/index.d.ts",
  "dependencies": {
    "@assessmentis/clinical-domain": "*",
    "@assessmentis/config-domain": "*",
    "@assessmentis/daily-co-infrastructure": "*",
    "@assessmentis/fhir-client": "*",
    "@assessmentis/firebase-server-infrastructure": "*",
    "@assessmentis/google-fhir-node-infrastructure": "*",
    "@assessmentis/ontology": "*",
    "@assessmentis/platform-domain": "*",
    "@assessmentis/video-call-domain": "*",
    "@effect/cluster": "^0.56.3",
    "@effect/opentelemetry": "^0.61.0",
    "@effect/platform": "^0.94.0",
    "@effect/platform-node": "^0.104.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.211.0",
    "effect": "^3.19.9",
    "eslint": "^9.39.1",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.5",
    "googleapis": "^168.0.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@assessmentis/prettier-config": "*",
    "@assessmentis/testing-utils": "*",
    "@types/gapi": "^0.0.47",
    "@types/gapi.client.healthcare-v1": "^0.0.4",
    "@types/node": "^25.2.3",
    "@types/node-fetch": "^3.0.2",
    "esbuild": "^0.27.3",
    "fast-check": "^3.23.2",
    "firebase-functions-test": "^3.4.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "private": true
}
